{
  "name": "astra-chess",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Authored and experimentally engine-tuned sparse chess policies, without inference-time search",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "weights": "node tools/compile-models.mjs && node tools/rebuild-engine-tuned.mjs",
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "bench": "node tools/benchmark.mjs",
    "bench:v2": "node tools/benchmark-v2.mjs"
  },
  "dependencies": {"chess.js": "1.4.0"},
  "devDependencies": {}
}
